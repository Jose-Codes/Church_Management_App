# This app talks to the SAME Supabase project as the church-management app.
# The defaults baked into src/app/lib/supabaseClient.ts already point at that
# shared project, so you only need this file if you want to point the app at
# a different project (e.g. your own scratch project while developing).
#
# Copy to .env.local (git-ignored) and fill in, or leave unset to use the
# shared project's defaults.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where "Forgot password?" emails send people to finish the reset. The
# church-management app already has this page built (app/(marketing)/reset-password)
# against the same Supabase project, so point this at wherever that app is
# deployed, e.g.:
# VITE_PASSWORD_RESET_URL=https://your-church-management-app.example.com/reset-password
VITE_PASSWORD_RESET_URL=
